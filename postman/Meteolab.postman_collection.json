      "name": "Gestion des erreurs",
      "description": "Requêtes illustrant la gestion des erreurs implémentée côté Angular (WeatherService) : ville introuvable (404). Le service Angular traduit ces réponses en messages utilisateur (voir README).",
      "item": [
        {
          "name": "Ville introuvable (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/weather?q=VilleInexistanteXYZ123&appid={{api_key}}&units=metric&lang=fr",
              "host": ["{{base_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "q", "value": "VilleInexistanteXYZ123", "description": "Ville volontairement invalide" },
