{
  "info": {
    "_postman_id": "5f3a6e0a-9d3b-4b7a-8c2b-1e7c0f5a2b10",
    "name": "Meteolab - Weather App",
    "description": "Collection Postman du projet Meteolab (IPSSI - groupe 7). Permet de tester les endpoints OpenWeather utilisés par l'application Angular : météo actuelle (Current Weather) et prévisions 5 jours (Forecast, fonctionnalité libre).\n\nVariables à renseigner :\n- base_url : https://api.openweathermap.org/data/2.5\n- api_key : votre clé API OpenWeather personnelle (jamais commitée)\n- city : ville par défaut utilisée par les requêtes (ex. Paris)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://api.openweathermap.org/data/2.5", "type": "string" },
    { "key": "api_key", "value": "", "type": "string" },
    { "key": "city", "value": "Paris", "type": "string" }
  ],
  "item": [
    {
      "name": "Current Weather",
      "description": "Météo actuelle d'une ville. Endpoint : GET /weather. Utilisé par WeatherService.getCurrentWeather() pour alimenter le WeatherComponent (nom ville, pays, température, ressenti, humidité, vent, icône).",
      "item": [
        {
          "name": "Paris",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/weather?q=Paris&appid={{api_key}}&units=metric&lang=fr",
              "host": ["{{base_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "q", "value": "Paris", "description": "Nom de la ville recherchée" },
                { "key": "appid", "value": "{{api_key}}", "description": "Clé API OpenWeather" },
                { "key": "units", "value": "metric", "description": "Températures renvoyées directement en °C" },
                { "key": "lang", "value": "fr", "description": "Description météo en français" }
              ]
            },
            "description": "Objectif : récupérer la météo actuelle de Paris.\n\nMéthode : GET\nParamètres : q (ville), appid (clé API), units=metric (°C), lang=fr\n\nRéponse attendue : 200 OK, JSON contenant name, sys.country, main.temp, main.feels_like, main.humidity, wind.speed, weather[0].description, weather[0].icon."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Contient les donnees meteo attendues', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('name');",
                  "  pm.expect(body.sys).to.have.property('country');",
                  "  pm.expect(body.main).to.have.property('temp');",
                  "  pm.expect(body.main).to.have.property('feels_like');",
                  "  pm.expect(body.main).to.have.property('humidity');",
                  "  pm.expect(body.wind).to.have.property('speed');",
                  "  pm.expect(body.weather[0]).to.have.property('description');",
                  "  pm.expect(body.weather[0]).to.have.property('icon');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Lille",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/weather?q=Lille&appid={{api_key}}&units=metric&lang=fr",
              "host": ["{{base_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "q", "value": "Lille" },
                { "key": "appid", "value": "{{api_key}}" },
                { "key": "units", "value": "metric" },
                { "key": "lang", "value": "fr" }
              ]
            },
            "description": "Objectif : récupérer la météo actuelle de Lille.\n\nMéthode : GET\nParamètres : q (ville), appid (clé API), units=metric (°C), lang=fr\n\nRéponse attendue : 200 OK, même structure JSON que la requête Paris."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Ville correspond a la requete', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.name.toLowerCase()).to.include('lille');",
                  "});"
                ]
              }
            }
          ],
          "response": []
