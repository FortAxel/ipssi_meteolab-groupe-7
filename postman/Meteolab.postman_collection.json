    {
      "name": "Forecast",
      "description": "Prévisions météo sur 5 jours (fonctionnalité libre de la Personne 4). Endpoint : GET /forecast. Renvoie des créneaux de 3h sur 5 jours (~40 entrées), regroupés par jour côté Angular (WeatherService.getForecast) pour calculer un min/max et une icône représentative par jour, affichés par le composant Forecast.",
      "item": [
        {
          "name": "Paris",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/forecast?q=Paris&appid={{api_key}}&units=metric&lang=fr",
              "host": ["{{base_url}}"],
              "path": ["forecast"],
              "query": [
                { "key": "q", "value": "Paris", "description": "Nom de la ville recherchée" },
                { "key": "appid", "value": "{{api_key}}", "description": "Clé API OpenWeather" },
                { "key": "units", "value": "metric", "description": "Températures renvoyées directement en °C" },
                { "key": "lang", "value": "fr", "description": "Description météo en français" }
              ]
            },
            "description": "Objectif : récupérer les prévisions météo sur 5 jours (créneaux de 3h) pour Paris.\n\nMéthode : GET\nEndpoint : /forecast\nParamètres : q (ville), appid (clé API), units=metric (°C), lang=fr\n\nRéponse attendue : 200 OK, JSON contenant city.name, city.country et une liste `list` d'environ 40 entrées, chacune avec dt_txt (date/heure), main.temp, weather[0].description et weather[0].icon."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Contient une liste de previsions', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('list');",
                  "  pm.expect(body.list).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Chaque entree contient les donnees attendues', () => {",
                  "  const body = pm.response.json();",
                  "  const item = body.list[0];",
                  "  pm.expect(item).to.have.property('dt_txt');",
                  "  pm.expect(item.main).to.have.property('temp');",
                  "  pm.expect(item.weather[0]).to.have.property('description');",
                  "  pm.expect(item.weather[0]).to.have.property('icon');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
